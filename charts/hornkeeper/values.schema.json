{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "controller", "rbac", "serviceAccount", "metrics"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "pattern": "^$|^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}$"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {"name": {"$ref": "#/definitions/resourceName"}}
      }
    },
    "nameOverride": {"$ref": "#/definitions/optionalName"},
    "fullnameOverride": {"$ref": "#/definitions/optionalName"},
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longhornNamespace", "defaultBackupTarget", "defaultReplicas", "resyncInterval", "leaderElection", "logLevel"],
      "properties": {
        "longhornNamespace": {"$ref": "#/definitions/namespace"},
        "defaultBackupTarget": {"$ref": "#/definitions/resourceName"},
        "defaultReplicas": {"type": "integer", "minimum": 1, "maximum": 20},
        "resyncInterval": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|μs|ms|s|m|h))+$",
          "not": {"pattern": "^(0+(\\.0+)?(ns|us|µs|μs|ms|s|m|h))+$"}
        },
        "leaderElection": {"type": "boolean"},
        "logLevel": {"enum": ["debug", "info", "warn", "error"]}
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": {"create": {"type": "boolean"}}
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
        "annotations": {"$ref": "#/definitions/annotations"}
      },
      "allOf": [
        {
          "if": {"properties": {"create": {"const": false}}},
          "then": {"properties": {"name": {"minLength": 1}}}
        }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "podAnnotations": {"$ref": "#/definitions/annotations"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "resources": {"type": "object"},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "affinity": {"type": "object"},
    "global": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"controller": {"properties": {"leaderElection": {"const": false}}}}},
      "then": {"properties": {"replicaCount": {"const": 1}}}
    }
  ],
  "definitions": {
    "namespace": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "resourceName": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
    "optionalName": {"type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
